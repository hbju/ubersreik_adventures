{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.hbju.ubersreikadventures.player",
  "productName": "WFRP Player Client",
  "executableName": "WFRPPlayerClient",    
  "artifactName": "WFRPPlayerClient-${version}.${ext}",

  "asar": true,
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist-electron",
    "dist"
  ],
  "mac": {
    "artifactName": "WFRPPlayerClient-${version}.${ext}",
    "target": [
      "dmg",
      "zip"
    ],
    "identity": null,
    "notarize": false
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "WFRPPlayerClient-${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  },
  "publish": {
    "provider": "github",
    "owner": "hbju",
    "repo": "ubersreik_adventures",
    "releaseType": "release"
  }
}
