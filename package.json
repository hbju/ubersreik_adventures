{
  "name": "ubersreik_adventures",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for the WFRP4e GM and Player application suite.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev:gm": "npm run dev -w @wfrp/gm-app",
    "build:gm": "npm run build -w @wfrp/gm-app",
    "dev:player": "npm run dev -w @wfrp/player-app",
    "build:player": "npm run build -w @wfrp/player-app",
    "build:shared": "npm run build -w @wfrp/shared"
  },
  "author": "milouordo",
  "license": "ISC",
  "dependencies": {
    "@wfrp/shared": "^1.0.0"
  }
}
