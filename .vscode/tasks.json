{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "GM App: Vite Debug Server",
            "type": "shell",
            "command": "npm run dev:gm",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "VSCODE_DEBUG": "true"
                }
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "typescript",
                "pattern": {
                    "regexp": "^([^:]+):(\\d+):(\\d+):\\s+(ERROR|WARNING):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*VITE.*ready in.*",
                    "endsPattern": ".*\\[startup\\] Electron App.*"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        }
    ]
}
